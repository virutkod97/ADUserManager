@page
@model ADUserManager.Pages.Rules.IndexModel
@{
    ViewData["Title"] = "Rule tài khoản";
    var main = Model.Rules.Where(r => !r.IsPermission).ToList();
    var perms = Model.Rules.Where(r => r.IsPermission).ToList();
}
<div class="page-head">
    <h1>Rule tài khoản</h1>
    <div class="actions">
        <a class="btn btn-primary" href="/Rules/Edit">+ Rule chính</a>
        <a class="btn" href="/Rules/Edit?kind=Permission">+ Rule phân quyền</a>
    </div>
</div>

<section class="card">
    <div class="card-head">
        <h2>Rule chính</h2>
        <span class="muted">Quy định OU và group. Mỗi tài khoản có đúng 1 rule chính. Rule có đánh dấu <span class="badge badge-info">Thử việc</span> sẽ nhắc chuyển rule khi hết số ngày thử việc.</span>
    </div>
    @if (main.Count == 0)
    {
        <p class="empty">Chưa có rule chính nào. <a href="/Rules/Edit">Tạo rule chính</a>.</p>
    }
    else
    {
        <div class="table-wrap">
        <table class="table">
            <thead>
            <tr><th>Tên rule</th><th>OU</th><th>Group</th><th>Primary group</th><th>Thử việc</th><th>Số tài khoản</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var r in main)
            {
                <tr>
                    <td>
                        <a href="/Rules/Edit?id=@r.Id"><strong>@r.Name</strong></a>
                        @if (!string.IsNullOrEmpty(r.Description)) { <div class="muted small">@r.Description</div> }
                    </td>
                    <td class="small" title="@r.OuDn">@DnHelper.ToPath(r.OuDn)</td>
                    <td class="small"><partial name="_GroupChips" model="r.GroupDns" /></td>
                    <td class="small">@(string.IsNullOrEmpty(r.PrimaryGroupDn) ? "Tự động" : DnHelper.RdnValue(DnHelper.Split(r.PrimaryGroupDn)[0]))</td>
                    <td>
                        @if (r.IsProbation) { <span class="badge badge-info">✓ @r.ProbationDays ngày</span> }
                        else { <span class="muted">—</span> }
                    </td>
                    <td><a href="/Users?rule=@r.Id">@r.UserCount</a></td>
                    <td class="right nowrap"><partial name="_RuleActions" model="r" /></td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
</section>

<section class="card">
    <div class="card-head">
        <h2>Rule phân quyền</h2>
        <span class="muted">Chỉ thêm group, không thay đổi OU. Một tài khoản có thể được gán nhiều rule phân quyền (VD: Trưởng bộ phận, Pháp chế).</span>
    </div>
    @if (perms.Count == 0)
    {
        <p class="empty">Chưa có rule phân quyền nào. <a href="/Rules/Edit?kind=Permission">Tạo rule phân quyền</a>.</p>
    }
    else
    {
        <div class="table-wrap">
        <table class="table">
            <thead>
            <tr><th>Tên rule</th><th>Group được thêm</th><th>Số tài khoản</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var r in perms)
            {
                <tr>
                    <td>
                        <a href="/Rules/Edit?id=@r.Id"><strong>@r.Name</strong></a>
                        @if (!string.IsNullOrEmpty(r.Description)) { <div class="muted small">@r.Description</div> }
                    </td>
                    <td class="small"><partial name="_GroupChips" model="r.GroupDns" /></td>
                    <td><a href="/Users?rule=@r.Id">@r.UserCount</a></td>
                    <td class="right nowrap"><partial name="_RuleActions" model="r" /></td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
</section>
