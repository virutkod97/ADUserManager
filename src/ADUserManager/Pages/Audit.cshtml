@page
@model AuditModel
@{
    ViewData["Title"] = "Nhật ký thao tác";
}
<div class="page-head">
    <h1>Nhật ký thao tác</h1>
</div>
<form method="get" class="toolbar">
    <input type="search" name="q" value="@Model.Q" placeholder="Lọc theo người thực hiện, thao tác, đối tượng..." />
    <button class="btn" type="submit">Lọc</button>
</form>
<section class="card">
    <div class="table-wrap">
    <table class="table">
        <thead>
        <tr><th>Thời gian</th><th>Người thực hiện</th><th>Thao tác</th><th>Đối tượng</th><th>Chi tiết</th><th>Kết quả</th><th>IP</th></tr>
        </thead>
        <tbody>
        @foreach (var l in Model.Logs)
        {
            <tr>
                <td class="nowrap">@l.Time.ToLocalDisplay()</td>
                <td>@l.Actor</td>
                <td class="nowrap">@l.Action</td>
                <td>@l.Target</td>
                <td class="small">@l.Details</td>
                <td>@if (l.Success) { <span class="badge badge-ok">OK</span> } else { <span class="badge badge-danger">Lỗi</span> }</td>
                <td class="small">@l.ClientIp</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    @if (Model.Logs.Count == 0) { <p class="empty">Chưa có nhật ký.</p> }
    <p class="muted small">Hiển thị tối đa @AuditModel.PageSize bản ghi mới nhất.</p>
</section>
