@inject RuleService Rules
@inject IAdService Ad
@inject UpdateService Updates
@{
    var path = Context.Request.Path.Value ?? "/";
    string Active(string prefix) => (prefix == "/" ? path == "/" : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var dueCount = await Rules.CountDueProbationAsync();
    var displayName = User.FindFirst("display")?.Value ?? User.Identity?.Name;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – AD User Manager</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app">
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-mark">AD</span>
            <div>
                <div class="brand-name">User Manager</div>
                <div class="brand-domain">@Ad.DomainName</div>
            </div>
        </div>
        <nav>
            <a class="@Active("/")" href="/">Tổng quan
                @if (dueCount > 0) { <span class="badge badge-warn" title="Tài khoản thử việc đến hạn chuyển rule">@dueCount</span> }
            </a>
            <a class="@Active("/Users")" href="/Users">Tài khoản</a>
            <a class="@Active("/Rules")" href="/Rules">Rule tài khoản</a>
            <a class="@Active("/Audit")" href="/Audit">Nhật ký thao tác</a>
            <a class="@Active("/Update")" href="/Update">Cập nhật
                @if (Updates.UpdateAvailable) { <span class="badge badge-warn" title="Có phiên bản mới">mới</span> }
            </a>
        </nav>
        <div class="sidebar-foot">
            <div class="me" title="@User.Identity?.Name">@displayName</div>
            <div class="foot-row">
                <form method="post" asp-page="/Logout">
                    <button type="submit" class="btn btn-ghost btn-sm">Đăng xuất</button>
                </form>
                <button type="button" class="theme-toggle" data-theme-toggle aria-label="Đổi giao diện sáng/tối"></button>
            </div>
            <div class="version">
                v@(Updates.CurrentVersion)
                @if (Updates.UpdateAvailable) { <a href="/Update" class="update-dot" title="Có bản @Updates.Latest!.Tag">● có bản mới</a> }
            </div>
        </div>
    </aside>
    <main class="content">
        @if (dueCount > 0 && !path.Equals("/", StringComparison.Ordinal))
        {
            <div class="alert alert-warn">
                Có <strong>@dueCount</strong> tài khoản thử việc đã đến hạn chuyển rule.
                <a href="/">Xem danh sách</a>
            </div>
        }
        @if (Updates.UpdateAvailable && !path.StartsWith("/Update", StringComparison.OrdinalIgnoreCase))
        {
            <div class="alert alert-info">
                Đã có phiên bản mới <strong>@Updates.Latest!.Tag</strong> (đang dùng v@(Updates.CurrentVersion)).
                <a href="/Update">Xem và cập nhật</a>
            </div>
        }
        <partial name="_Flash" />
        @RenderBody()
    </main>
</div>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
