@page
@model ADUserManager.Pages.Users.ResetPasswordModel
@{
    ViewData["Title"] = "Reset mật khẩu";
}
<div class="page-head">
    <h1>Reset mật khẩu <span class="muted h-sub">@Model.AdUser?.SamAccountName – @Model.AdUser?.DisplayName</span></h1>
    <div class="actions"><a class="btn" href="/Users/Edit?sam=@Uri.EscapeDataString(Model.Sam)">← Tài khoản</a></div>
</div>

@if (Model.Done)
{
    <div class="card">
        <div class="alert alert-ok">Đã đặt lại mật khẩu cho <strong>@Model.Sam</strong>.</div>
        <p>Mật khẩu mới:</p>
        <div class="input-group">
            <input class="mono big" id="new-pw" value="@Model.Input.NewPassword" readonly />
            <button type="button" class="btn" data-copy="#new-pw">Sao chép</button>
        </div>
        <p class="muted small">Mật khẩu chỉ hiển thị một lần. @(Model.Input.MustChange ? "Người dùng sẽ phải đổi mật khẩu ở lần đăng nhập tới." : "")</p>
        <div class="form-actions">
            <a class="btn btn-primary" href="/Users">Về danh sách tài khoản</a>
        </div>
    </div>
}
else
{
    <form method="post" class="card form narrow">
        <input type="hidden" name="sam" value="@Model.Sam" />
        <div asp-validation-summary="ModelOnly" class="alert alert-err"></div>
        @if (Model.AdUser?.LockedOut == true)
        {
            <div class="alert alert-warn">Tài khoản đang bị khoá.</div>
        }
        <label class="field">
            <span>Mật khẩu mới *</span>
            <div class="input-group">
                <input asp-for="Input.NewPassword" type="text" class="mono" autocomplete="new-password" id="f-newpw" />
                <button type="button" class="btn" data-generate="#f-newpw">Tạo ngẫu nhiên</button>
            </div>
            <span asp-validation-for="Input.NewPassword" class="field-err"></span>
        </label>
        <label class="check"><input asp-for="Input.MustChange" /> <span>Bắt đổi mật khẩu ở lần đăng nhập tới</span></label>
        <label class="check"><input asp-for="Input.Unlock" /> <span>Mở khoá tài khoản nếu đang bị khoá</span></label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Đặt lại mật khẩu</button>
        </div>
    </form>
}
