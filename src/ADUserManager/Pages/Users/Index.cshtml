@page
@model ADUserManager.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Tài khoản";
    var mainRules = Model.Rules.Where(r => !r.IsPermission).ToList();
}
<div class="page-head">
    <h1>Tài khoản</h1>
    <div class="actions"><a class="btn btn-primary" href="/Users/Create">+ Tạo tài khoản</a></div>
</div>

<form method="get" class="toolbar">
    <input type="search" name="q" value="@Model.Q" placeholder="Tìm theo tài khoản, họ tên, email..." />
    <select name="rule">
        <option value="">Tất cả rule</option>
        <option value="none" selected="@(Model.RuleFilter == "none")">Chưa gán rule</option>
        <option value="due" selected="@(Model.RuleFilter == "due")">Đến hạn chuyển rule</option>
        <optgroup label="Rule chính">
            @foreach (var r in Model.Rules.Where(r => !r.IsPermission))
            {
                <option value="@r.Id" selected="@(Model.RuleFilter == r.Id.ToString())">@r.Name</option>
            }
        </optgroup>
        <optgroup label="Rule phân quyền">
            @foreach (var r in Model.Rules.Where(r => r.IsPermission))
            {
                <option value="@r.Id" selected="@(Model.RuleFilter == r.Id.ToString())">@r.Name</option>
            }
        </optgroup>
    </select>
    <label class="check toolbar-check"><input type="checkbox" name="all" value="true" checked="@Model.ShowAll" data-autosubmit /> <span>Hiện cả tài khoản bị vô hiệu hoá</span></label>
    <button class="btn" type="submit">Lọc</button>
</form>

@if (Model.LoadError is not null)
{
    <div class="alert alert-err">@Model.LoadError</div>
}

<section class="card">
    <div class="card-head">
        <span class="muted">
            @Model.Users.Count tài khoản@(Model.ShowAll ? "" : " đang hoạt động")
            @if (Model.HiddenDisabled > 0) { <text>· @Model.HiddenDisabled tài khoản vô hiệu hoá đang ẩn (<a href="?q=@Uri.EscapeDataString(Model.Q ?? "")&rule=@Model.RuleFilter&all=true">hiện</a>)</text> }
            @(Model.Truncated ? " (đã đạt giới hạn kết quả, hãy thu hẹp tìm kiếm)" : "")
        </span>
    </div>
    @if (Model.Users.Count == 0)
    {
        <p class="empty">Không có tài khoản phù hợp.</p>
    }
    else
    {
        <div class="table-wrap table-tall">
        <table class="table">
            <thead>
            <tr><th>Tài khoản</th><th>Họ tên</th><th>OU</th><th>Rule chính</th><th>Trạng thái</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var u in Model.Users)
            {
                var a = Model.Assignments.GetValueOrDefault(u.SamAccountName);
                var ps = RuleService.GetProbationStatus(a);
                <tr class="@(ps?.IsDue == true ? "row-warn" : "")">
                    <td>
                        <a href="/Users/Edit?sam=@Uri.EscapeDataString(u.SamAccountName)"><strong>@u.SamAccountName</strong></a>
                        <div class="muted small">@u.Email</div>
                    </td>
                    <td>@u.DisplayName</td>
                    <td class="small" title="@u.ParentDn">@DnHelper.ToPath(u.ParentDn)</td>
                    <td class="rule-cell">
                        <select name="rules[@u.SamAccountName]" form="bulk-form" class="rule-select" data-bulk-rule
                                data-original="@(a?.RuleId.ToString() ?? "")" aria-label="Rule chính của @u.SamAccountName">
                            @if (a is null) { <option value="" selected>— Chưa gán —</option> }
                            @foreach (var r in mainRules)
                            {
                                <option value="@r.Id" selected="@(a?.RuleId == r.Id)">@r.Name@(r.IsProbation ? " (thử việc)" : "")</option>
                            }
                        </select>
                        <partial name="_ProbationBadge" model="ps" />
                        @if (Model.Permissions.GetValueOrDefault(u.SamAccountName) is { } perms)
                        {
                            <div>@foreach (var p in perms) { <span class="chip chip-perm" title="Rule phân quyền">@p.Rule!.Name</span> }</div>
                        }
                    </td>
                    <td class="nowrap">
                        @if (u.Enabled) { <span class="badge badge-ok">Hoạt động</span> }
                        else { <span class="badge badge-muted">Vô hiệu</span> }
                        @if (u.LockedOut) { <span class="badge badge-danger">Bị khoá</span> }
                    </td>
                    <td class="right nowrap">
                        <a class="btn btn-sm" href="/Users/Edit?sam=@Uri.EscapeDataString(u.SamAccountName)">Sửa</a>
                        <a class="btn btn-sm" href="/Users/ResetPassword?sam=@Uri.EscapeDataString(u.SamAccountName)">Reset MK</a>
                        <details class="menu">
                            <summary class="btn btn-sm">⋯</summary>
                            <div class="menu-body">
                                @if (u.LockedOut)
                                {
                                    <form method="post" asp-page-handler="Unlock" asp-route-sam="@u.SamAccountName" asp-route-q="@Model.Q" asp-route-rule="@Model.RuleFilter" asp-route-all="@(Model.ShowAll ? "true" : null)">
                                        <button type="submit">Mở khoá</button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="Toggle" asp-route-sam="@u.SamAccountName" asp-route-enable="@(!u.Enabled)" asp-route-q="@Model.Q" asp-route-rule="@Model.RuleFilter" asp-route-all="@(Model.ShowAll ? "true" : null)"
                                      data-confirm="@(u.Enabled ? "Vô hiệu hoá" : "Kích hoạt") tài khoản @u.SamAccountName?">
                                    <button type="submit">@(u.Enabled ? "Vô hiệu hoá" : "Kích hoạt")</button>
                                </form>
                                <form method="post" asp-page-handler="Delete" asp-route-sam="@u.SamAccountName" asp-route-q="@Model.Q" asp-route-rule="@Model.RuleFilter" asp-route-all="@(Model.ShowAll ? "true" : null)"
                                      data-confirm="XOÁ VĨNH VIỄN tài khoản @u.SamAccountName (@u.DisplayName)? Thao tác không thể hoàn tác.">
                                    <button type="submit" class="danger">Xoá tài khoản</button>
                                </form>
                            </div>
                        </details>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
</section>

<form method="post" id="bulk-form" asp-page-handler="BulkRule" asp-route-q="@Model.Q" asp-route-rule="@Model.RuleFilter" asp-route-all="@(Model.ShowAll ? "true" : null)"
      class="bulk-bar" hidden>
    <div class="bulk-count"><strong data-bulk-count>0</strong> tài khoản đổi rule chính</div>
    <div class="bulk-actions">
        <button type="button" class="btn" data-bulk-reset>Huỷ</button>
        <button type="submit" class="btn btn-primary">Lưu</button>
    </div>
</form>
