@page
@model ADUserManager.Pages.Users.EditModel
@{
    var u = Model.AdUser!;
    ViewData["Title"] = u.SamAccountName;
    var ps = RuleService.GetProbationStatus(Model.Assignment);
    var samQ = Uri.EscapeDataString(u.SamAccountName);
}
<div class="page-head">
    <div>
        <h1>@u.SamAccountName <span class="muted h-sub">@u.DisplayName</span></h1>
        <div class="badges">
            @if (u.Enabled) { <span class="badge badge-ok">Hoạt động</span> } else { <span class="badge badge-muted">Vô hiệu</span> }
            @if (u.LockedOut) { <span class="badge badge-danger">Bị khoá</span> }
            <partial name="_ProbationBadge" model="ps" />
        </div>
    </div>
    <div class="actions">
        <a class="btn" href="/Users">← Danh sách</a>
        <a class="btn" href="/Users/ResetPassword?sam=@samQ">Reset mật khẩu</a>
        @if (u.LockedOut)
        {
            <form method="post" asp-page-handler="Unlock" asp-route-sam="@u.SamAccountName" class="inline">
                <button class="btn" type="submit">Mở khoá</button>
            </form>
        }
        <form method="post" asp-page-handler="Toggle" asp-route-sam="@u.SamAccountName" asp-route-enable="@(!u.Enabled)" class="inline"
              data-confirm="@(u.Enabled ? "Vô hiệu hoá" : "Kích hoạt") tài khoản @u.SamAccountName?">
            <button class="btn" type="submit">@(u.Enabled ? "Vô hiệu hoá" : "Kích hoạt")</button>
        </form>
        <form method="post" asp-page-handler="Delete" asp-route-sam="@u.SamAccountName" class="inline"
              data-confirm="XOÁ VĨNH VIỄN tài khoản @u.SamAccountName (@u.DisplayName)? Thao tác không thể hoàn tác.">
            <button class="btn btn-danger" type="submit">Xoá</button>
        </form>
    </div>
</div>

@if (ps?.IsDue == true)
{
    <div class="alert alert-warn">
        Tài khoản đã thuộc rule thử việc <strong>@Model.Assignment!.Rule!.Name</strong> được <strong>@ps.DaysElapsed ngày</strong>
        (quy định @ps.ProbationDays ngày). Hãy chuyển tài khoản sang rule chính thức ở mục <a href="#rule">Rule tài khoản</a> bên dưới.
    </div>
}

<div class="grid-main">
    <form method="post" asp-page-handler="Save" asp-route-sam="@u.SamAccountName" class="card form">
        <h2>Thông tin tài khoản</h2>
        <div asp-validation-summary="ModelOnly" class="alert alert-err"></div>
        <div class="grid2">
            <label class="field"><span>Họ và tên đệm</span><input asp-for="Input.Surname" /></label>
            <label class="field"><span>Tên</span><input asp-for="Input.GivenName" /></label>
            <label class="field">
                <span>Tên hiển thị *</span><input asp-for="Input.DisplayName" />
                <span asp-validation-for="Input.DisplayName" class="field-err"></span>
            </label>
            <label class="field">
                <span>UPN *</span><input asp-for="Input.UserPrincipalName" />
                <span asp-validation-for="Input.UserPrincipalName" class="field-err"></span>
            </label>
            <label class="field">
                <span>Email</span><input asp-for="Input.Email" type="email" />
                <span asp-validation-for="Input.Email" class="field-err"></span>
            </label>
            <label class="field"><span>Mã nhân viên</span><input asp-for="Input.EmployeeId" /></label>
            <label class="field"><span>Điện thoại</span><input asp-for="Input.Phone" /></label>
            <label class="field"><span>Phòng ban</span><input asp-for="Input.Department" /></label>
            <label class="field"><span>Chức danh</span><input asp-for="Input.Title" /></label>
            <label class="field"><span>Mô tả</span><input asp-for="Input.Description" /></label>
        </div>
        <label class="check"><input asp-for="Input.PasswordNeverExpires" /> <span>Mật khẩu không bao giờ hết hạn</span></label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        </div>
    </form>

    <div class="stack">
        <section class="card" id="rule">
            <h2>Rule chính</h2>
            @if (Model.Assignment?.Rule is { } cur)
            {
                <dl class="kv">
                    <dt>Rule hiện tại</dt><dd><strong>@cur.Name</strong> @if (cur.IsProbation) { <span class="badge badge-info">Thử việc @cur.ProbationDays ngày</span> }</dd>
                    <dt>Từ ngày</dt><dd>@Model.Assignment.AssignedAt.ToLocalDisplay() (@Model.Assignment.AssignedBy)</dd>
                    @if (ps is not null)
                    {
                        <dt>Hạn thử việc</dt><dd>@ps.DueAtUtc.ToLocalDisplay()</dd>
                    }
                </dl>
            }
            else
            {
                <p class="muted">Tài khoản chưa được gán rule (có thể được tạo ngoài phần mềm).</p>
            }

            <form method="post" asp-page-handler="ChangeRule" asp-route-sam="@u.SamAccountName" class="form">
                <label class="field">
                    <span>@(Model.Assignment is null ? "Gán rule" : "Chuyển sang rule")</span>
                    <select name="newRuleId" required>
                        <option value="">— Chọn rule —</option>
                        @foreach (var r in Model.Rules.Where(r => !r.IsPermission && r.Id != Model.Assignment?.RuleId))
                        {
                            <option value="@r.Id">@r.Name — @DnHelper.ToPath(r.OuDn)@(r.IsProbation ? " (thử việc)" : "")</option>
                        }
                    </select>
                </label>
                <label class="check"><input type="checkbox" name="moveOu" value="true" checked /> <span>Di chuyển tài khoản sang OU của rule mới</span></label>
                <label class="check"><input type="checkbox" name="clearGroups" value="true" checked /> <span>Gỡ toàn bộ group hiện có trước khi thêm (giữ group do rule phân quyền cấp)</span></label>
                <label class="check"><input type="checkbox" name="addGroups" value="true" checked /> <span>Thêm vào các group của rule mới</span></label>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@(Model.Assignment is null ? "Gán rule" : "Chuyển rule")</button>
                </div>
            </form>
            @if (Model.Assignment is not null)
            {
                <form method="post" asp-page-handler="RemoveRule" asp-route-sam="@u.SamAccountName"
                      data-confirm="Bỏ theo dõi rule cho tài khoản này? (Không thay đổi OU/group trên AD)">
                    <button type="submit" class="btn btn-ghost btn-sm">Bỏ gán rule</button>
                </form>
            }
        </section>

        <section class="card" id="permissions">
            <h2>Rule phân quyền (@Model.Permissions.Count)</h2>
            @if (Model.Permissions.Count == 0)
            {
                <p class="muted">Chưa gán rule phân quyền nào.</p>
            }
            else
            {
                <div class="perm-list">
                    @foreach (var p in Model.Permissions)
                    {
                        <div class="perm-item">
                            <div>
                                <strong>@p.Rule!.Name</strong>
                                <div class="small"><partial name="_GroupChips" model="p.Rule.GroupDns" /></div>
                                <div class="muted small">Từ @p.AssignedAt.ToLocalDisplay() (@p.AssignedBy)</div>
                            </div>
                            <form method="post" asp-page-handler="RemovePermission" asp-route-sam="@u.SamAccountName" asp-route-ruleId="@p.RuleId"
                                  data-confirm="Gỡ rule phân quyền '@p.Rule.Name' và các group của rule này khỏi @u.SamAccountName?">
                                <button type="submit" class="btn btn-sm btn-danger">Gỡ</button>
                            </form>
                        </div>
                    }
                </div>
            }
            @{
                var assignedIds = Model.Permissions.Select(p => p.RuleId).ToHashSet();
                var available = Model.Rules.Where(r => r.IsPermission && !assignedIds.Contains(r.Id)).ToList();
            }
            @if (available.Count > 0)
            {
                <form method="post" asp-page-handler="AddPermission" asp-route-sam="@u.SamAccountName" class="form">
                    <label class="field">
                        <span>Thêm rule phân quyền</span>
                        <select name="ruleId" required>
                            <option value="">— Chọn rule phân quyền —</option>
                            @foreach (var r in available)
                            {
                                <option value="@r.Id">@r.Name — + @string.Join(", ", r.GroupDns.Select(g => DnHelper.RdnValue(DnHelper.Split(g)[0])))</option>
                            }
                        </select>
                    </label>
                    <button type="submit" class="btn btn-primary">Thêm quyền</button>
                </form>
            }
            else if (!Model.Rules.Any(r => r.IsPermission))
            {
                <p class="muted small">Chưa có rule phân quyền. <a href="/Rules/Edit?kind=Permission">Tạo rule phân quyền</a>.</p>
            }
        </section>

        <section class="card">
            <h2>Thông tin AD</h2>
            <dl class="kv">
                <dt>OU</dt><dd title="@u.ParentDn">@DnHelper.ToPath(u.ParentDn)</dd>
                <dt>DN</dt><dd class="small mono">@u.DistinguishedName</dd>
                <dt>Ngày tạo</dt><dd>@u.WhenCreated.ToLocalDisplay()</dd>
                <dt>Đăng nhập gần nhất</dt><dd>@u.LastLogon.ToLocalDisplay()</dd>
                <dt>Đổi mật khẩu</dt><dd>@(u.PasswordLastSet is null ? "Phải đổi ở lần đăng nhập tới" : u.PasswordLastSet.ToLocalDisplay())</dd>
            </dl>
        </section>

        <section class="card">
            <h2>Group (@u.MemberOf.Count)</h2>
            @if (u.MemberOf.Count == 0)
            {
                <p class="muted">Không thuộc group nào (ngoài primary group).</p>
            }
            else
            {
                <div>
                    @foreach (var g in u.MemberOf.OrderBy(x => x))
                    {
                        var isPrimary = string.Equals(g, u.PrimaryGroupDn, StringComparison.OrdinalIgnoreCase);
                        <span class="chip @(isPrimary ? "chip-primary" : "")" title="@g@(isPrimary ? " (primary group)" : "")">@DnHelper.RdnValue(DnHelper.Split(g)[0])@(isPrimary ? " · primary" : "")</span>
                    }
                </div>
            }
        </section>
    </div>
</div>
